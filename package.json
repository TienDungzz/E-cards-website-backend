{
  "name": "e-cards-website-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API backend workspace for E-cards Website",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "start:local": "node --env-file-if-exists=.env src/server.mjs",
    "start:staging": "node scripts/start.mjs staging",
    "start:production": "node scripts/start.mjs production",
    "start": "node scripts/start.mjs production",
    "docs:generate": "node scripts/generate-schema-docs.mjs",
    "docs:images": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-db-diagrams.ps1",
    "check": "node scripts/check-project.mjs --run",
    "check:static": "node scripts/check-project.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:quality": "node scripts/check-quality.mjs --run",
    "check:schema": "node scripts/generate-schema-docs.mjs --check",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "eslint": "10.14.0"
  },
  "type": "module"
}
